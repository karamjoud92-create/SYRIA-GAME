    "econ": "node build.js && node tools/econ-check.mjs",
    "onboard": "node build.js && node tools/onboard-check.mjs",
    "guide": "node build.js && node tools/guide-check.mjs",
    "decide": "node build.js && node tools/decide-check.mjs",
    "levels": "node build.js && node tools/levels-check.mjs",
